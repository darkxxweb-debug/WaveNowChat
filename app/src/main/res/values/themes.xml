<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.WaveNow" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/screenBackground</item>
        <item name="android:statusBarColor">@color/toolbarBackground</item>
        <item name="android:navigationBarColor">@color/toolbarBackground</item>
    </style>

    <style name="Theme.WaveNow.Splash" parent="Theme.WaveNow">
        <item name="android:windowBackground">@color/colorPrimary</item>
    </style>

    <!-- HII NDI TULIYOONGEZA -->
    <style name="WaveNow" parent="Theme.WaveNow">
    </style>

    <style name="Toolbar.WaveNow" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/toolbarBackground</item>
        <item name="titleTextColor">@color/toolbarText</item>
    </style>

    <style name="WaveNow.FilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
